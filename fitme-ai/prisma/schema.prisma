// FitMe AI — Prisma schema
// Story 1.1 establishes the Better Auth core models (AD-6). Domain models
// (UserProfile, Goal, FoodEntry, ...) are added by their own stories so each
// migration is scoped to the story that needs it (see epics.md).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Better Auth core (email/password, DB-backed sessions)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions      Session[]
  accounts      Account[]
  profile       UserProfile?
  goal          Goal?
  foodEntries    FoodEntry[]
  exerciseEntries ExerciseEntry[]
  waterEntries   WaterEntry[]
  weightEntries  WeightEntry[]
  fastingSessions FastingSession[]
  glucoseEntries GlucoseEntry[]
  aiInteractions AIInteraction[]
  corrections   UserCorrection[]
  subscription  Subscription?

  @@map("user")
}

// ---------------------------------------------------------------------------
// Profile & goals (Story 1.6 / FR-4) — canonical units: g, cm, kcal, ml (AD-11)
// ---------------------------------------------------------------------------

enum Sex {
  male
  female
}

enum ActivityLevel {
  sedentary
  lightly_active
  moderately_active
  very_active
  extra_active
}

enum GoalType {
  weight_loss
  maintenance
  muscle_gain
  general_health
}

enum PreferredUnits {
  metric
  imperial
}

enum AppearancePreference {
  system
  light
  dark
}

model UserProfile {
  id                 String         @id @default(cuid())
  userId             String         @unique
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName        String
  ageYears           Int
  sex                Sex
  heightCm           Float
  currentWeightG     Int
  targetWeightG      Int
  activityLevel      ActivityLevel
  dietaryPreferences String[]       @default([])
  goalType           GoalType
  preferredUnits     PreferredUnits @default(metric)
  /// Display unit for blood sugar; storage stays canonical mg/dL.
  preferredGlucoseUnit GlucoseUnit  @default(mg_dl)
  /// When true, exercise burn is added to the day's food budget ("Remaining").
  eatBackExercise    Boolean        @default(false)
  /// Placeholder prefs until push/email delivery ships (Tier 3).
  notifyFastingEnd   Boolean        @default(false)
  notifyWeeklyDigest Boolean        @default(false)
  appearancePreference AppearancePreference @default(system)
  country            String         @default("")
  /// Boosts catalog search + AI parse hints (Story 12.1). `global` = no regional bias.
  catalogLocale      CatalogLocale  @default(global)
  timezone           String
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@map("user_profile")
}

enum GlucoseUnit {
  mg_dl
  mmol_l
}

enum SafetyLevel {
  green
  yellow
  red
}

model Goal {
  id                   String      @id @default(cuid())
  userId               String      @unique
  user                 User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  bmrKcal              Int
  tdeeKcal             Int
  caloriesKcal         Int
  proteinG             Int
  carbsG               Int
  fatG                 Int
  fibreG               Int
  waterMl              Int
  steps                Int
  exerciseMinutes      Int
  weeklyWeightChangeG  Int
  /// Overridden target field names (e.g. ["caloriesKcal","proteinG"]).
  overriddenFields     String[]    @default([])
  /// Story 1.7 / FR-5 — recorded safety ladder decision.
  safetyLevel          SafetyLevel @default(green)
  safetyReasons        String[]    @default([])
  safetyConsentGiven   Boolean     @default(false)
  safetyConsentAt      DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  @@map("goal")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// Nutrition catalog (Story 2.1 / FR-7 data layer) — AD-3, AD-11
// Ingredient macros are per 100 g. Missing macros are null (never fabricated).
// ---------------------------------------------------------------------------

enum FoodKind {
  simple
  composite
}

enum CatalogLocale {
  lk
  us
  in
  eu
  global
}

model Ingredient {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  aliases       String[] @default([])
  /// Provenance note (e.g. USDA FDC id + hand-curated note). Never log as health payload.
  sourceLabel   String
  /// Energy and macros per 100 g. Null = unknown (not zero).
  energyKcal    Float?
  proteinG      Float?
  carbsG        Float?
  fatG          Float?
  fibreG        Float?
  sugarG        Float?
  sodiumMg      Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  recipeRows RecipeIngredient[]

  @@index([name])
  @@map("ingredient")
}

model Food {
  id                   String   @id @default(cuid())
  slug                 String   @unique
  name                 String
  aliases              String[] @default([])
  kind                 FoodKind @default(simple)
  /// Grams produced by the default recipe (sum of recipe ingredient grams).
  /// DB CHECK: defaultServingG > 0 (migration 20260726020000).
  defaultServingG      Int
  sourceLabel          String
  locale               CatalogLocale @default(global)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  servings          FoodServing[]
  recipeIngredients RecipeIngredient[]
  foodEntries       FoodEntry[]

  @@index([name])
  @@map("food")
}

model FoodServing {
  id        String   @id @default(cuid())
  foodId    String
  food      Food     @relation(fields: [foodId], references: [id], onDelete: Cascade)
  name      String
  /// DB CHECK: grams > 0 (migration 20260726020000).
  grams     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([foodId, name])
  @@index([foodId])
  @@map("food_serving")
}

model RecipeIngredient {
  id           String     @id @default(cuid())
  foodId       String
  food         Food       @relation(fields: [foodId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  /// Grams of this ingredient in the food's defaultServingG yield.
  /// DB CHECK: grams > 0 (migration 20260726020000).
  grams        Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([foodId, ingredientId])
  @@index([foodId])
  @@index([ingredientId])
  @@map("recipe_ingredient")
}

// ---------------------------------------------------------------------------
// Logged food entries + corrections (Story 2.6 / FR-9, FR-20 / AD-8)
// Soft-delete via deletedAt. AIInteraction stub for provenance (full audit in 2.10).
// ---------------------------------------------------------------------------

enum NutritionDataSource {
  database
  ai_estimated
}

enum MealType {
  breakfast
  lunch
  dinner
  snack
  unknown
}

model FoodEntry {
  id          String              @id @default(cuid())
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  foodId      String?
  food        Food?               @relation(fields: [foodId], references: [id], onDelete: SetNull)
  name        String
  quantity    Float
  unit        String
  mealType    MealType
  loggedAt    DateTime
  dataSource  NutritionDataSource
  confidence  Float?
  energyKcal  Float?
  proteinG    Float?
  carbsG      Float?
  fatG        Float?
  fibreG      Float?
  sugarG      Float?
  sodiumMg    Float?
  /// Free-text context the user typed while logging ("shared with Amma").
  note        String?
  /// Client idempotency key for offline reconcile (Story 4.2 / AD-12).
  clientKey   String?
  /// Soft-delete (AD-8). Null = active.
  deletedAt   DateTime?
  /// Pin for one-tap re-log on Log (Story 5.5).
  isFavorite  Boolean             @default(false)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  aiInteractionId String?
  aiInteraction   AIInteraction?  @relation(fields: [aiInteractionId], references: [id], onDelete: SetNull)

  items       FoodEntryItem[]
  corrections UserCorrection[]

  @@unique([userId, clientKey])
  @@index([userId, loggedAt])
  @@index([userId, deletedAt])
  @@index([userId, isFavorite])
  @@index([foodId])
  @@index([aiInteractionId])
  @@map("food_entry")
}

model FoodEntryItem {
  id             String              @id @default(cuid())
  foodEntryId    String
  foodEntry      FoodEntry           @relation(fields: [foodEntryId], references: [id], onDelete: Cascade)
  ingredientSlug String?
  name           String
  grams          Int
  proportionPct  Float
  dataSource     NutritionDataSource
  energyKcal     Float?
  proteinG       Float?
  carbsG         Float?
  fatG           Float?
  fibreG         Float?
  sugarG         Float?
  sodiumMg       Float?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([foodEntryId])
  @@map("food_entry_item")
}

enum AiInteractionStatus {
  succeeded
  failed
}

/// AI audit row (Story 2.10 / FR-19 / AD-8). No free-text meal prompts stored.
model AIInteraction {
  id              String              @id @default(cuid())
  userId          String
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerId      String
  model           String?
  purpose         String
  status          AiInteractionStatus @default(succeeded)
  /// Safe failure code (e.g. validation_failed) — never a provider payload.
  errorCode       String?
  confidence      Float?
  /// Redacted request context: { purpose, promptCharLength } — never meal text.
  requestMeta     Json?
  /// Structured response summary for audit (item names/confidence) — DB only, never logged.
  responseSummary Json?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  foodEntries FoodEntry[]
  corrections UserCorrection[]

  @@index([userId, createdAt])
  @@index([userId, status])
  @@map("ai_interaction")
}

model UserCorrection {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  foodEntryId     String
  foodEntry       FoodEntry      @relation(fields: [foodEntryId], references: [id], onDelete: Cascade)
  aiInteractionId String?
  aiInteraction   AIInteraction? @relation(fields: [aiInteractionId], references: [id], onDelete: SetNull)
  /// Field path edited (e.g. name, quantity, energyKcal).
  field           String
  /// JSON-encoded before/after scalars — never logged as health payloads.
  beforeValue     Json
  afterValue      Json
  createdAt       DateTime       @default(now())

  @@index([userId, createdAt])
  @@index([foodEntryId])
  @@index([aiInteractionId])
  @@map("user_correction")
}

// ---------------------------------------------------------------------------
// Exercise entries (Story 3.2 / FR-14) — soft-delete; estimates labeled
// ---------------------------------------------------------------------------

enum ExerciseType {
  walking
  running
  treadmill
  cycling
  strength
  swimming
  sports
  custom
}

enum ExerciseIntensity {
  low
  moderate
  high
}

model ExerciseEntry {
  id              String            @id @default(cuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            ExerciseType
  /// Required when type = custom; optional display override otherwise.
  customLabel     String?
  durationMin     Int
  intensity       ExerciseIntensity
  distanceM       Int?
  sets            Int?
  reps            Int?
  /// Equipment / load mass in grams (canonical AD-11).
  weightG         Int?
  notes           String?
  estimatedKcal   Int
  metUsed         Float
  weightKgUsed    Float
  performedAt     DateTime
  /// Client idempotency key for offline reconcile (AD-12).
  clientKey       String?
  /// Soft-delete (AD-8). Null = active.
  deletedAt       DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([userId, clientKey])
  @@index([userId, performedAt])
  @@index([userId, deletedAt])
  @@map("exercise_entry")
}

// ---------------------------------------------------------------------------
// Water entries (Story 5.1 / FR-15 water) — soft-delete, canonical ml (AD-11)
// ---------------------------------------------------------------------------

model WaterEntry {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountMl  Int
  loggedAt  DateTime
  /// Client idempotency key for offline reconcile (AD-12).
  clientKey String?
  /// Soft-delete (AD-8). Null = active.
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([userId, clientKey])
  @@index([userId, loggedAt])
  @@index([userId, deletedAt])
  @@map("water_entry")
}

// ---------------------------------------------------------------------------
// Weight check-ins (Story 6.1 / Phase 2 body progress) — canonical g (AD-11)
// ---------------------------------------------------------------------------

model WeightEntry {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Body mass in grams (canonical).
  weightG    Int
  recordedAt DateTime
  note       String?
  /// Client idempotency key for offline reconcile (AD-12).
  clientKey  String?
  /// Soft-delete (AD-8). Null = active.
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([userId, clientKey])
  @@index([userId, recordedAt])
  @@index([userId, deletedAt])
  @@map("weight_entry")
}

// ---------------------------------------------------------------------------
// Fasting sessions (Story 7.1) — at most one active (endedAt null) per user
// ---------------------------------------------------------------------------

model FastingSession {
  id                 String    @id @default(cuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt          DateTime
  /// Null while the fast is in progress.
  endedAt            DateTime?
  /// Optional planned length in minutes (e.g. 16h = 960).
  plannedDurationMin Int?
  /// Free label e.g. "16:8", "OMAD", "custom".
  protocolLabel      String?
  notes              String?
  /// Soft-delete (AD-8). Null = active row.
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([userId, startedAt])
  @@index([userId, endedAt])
  @@index([userId, deletedAt])
  @@map("fasting_session")
}

// ---------------------------------------------------------------------------
// Glucose readings (Epic 8) — canonical mg/dL (AD-11)
// ---------------------------------------------------------------------------

enum GlucoseContext {
  fasting
  before_meal
  after_meal
  bedtime
  other
}

model GlucoseEntry {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Canonical mg/dL.
  valueMgDl   Float
  measuredAt  DateTime
  context     GlucoseContext  @default(other)
  note        String?
  /// Client idempotency key for offline reconcile (AD-12).
  clientKey   String?
  deletedAt   DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([userId, clientKey])
  @@index([userId, measuredAt])
  @@index([userId, deletedAt])
  @@map("glucose_entry")
}

// ---------------------------------------------------------------------------
// Subscriptions (Story 11.1 / Epic 11) — billing providers in 11.3+
// ---------------------------------------------------------------------------

enum PlanTier {
  free
  pro
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  canceled
  expired
}

model Subscription {
  id                    String             @id @default(cuid())
  userId                String             @unique
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  plan                  PlanTier           @default(free)
  status                SubscriptionStatus @default(expired)

  /// Stripe/PayHere ids — populated in Stories 11.3–11.4
  stripeCustomerId      String?            @unique
  stripeSubscriptionId  String?            @unique
  payhereSubscriptionId String?            @unique

  currentPeriodStart    DateTime?
  currentPeriodEnd      DateTime?
  cancelAtPeriodEnd     Boolean            @default(false)
  trialEndsAt           DateTime?

  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([status, currentPeriodEnd])
  @@map("subscription")
}
