// FitMe AI — Prisma schema
// Story 1.1 establishes the Better Auth core models (AD-6). Domain models
// (UserProfile, Goal, FoodEntry, ...) are added by their own stories so each
// migration is scoped to the story that needs it (see epics.md).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Better Auth core (email/password, DB-backed sessions)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions Session[]
  accounts Account[]
  profile  UserProfile?
  goal     Goal?

  @@map("user")
}

// ---------------------------------------------------------------------------
// Profile & goals (Story 1.6 / FR-4) — canonical units: g, cm, kcal, ml (AD-11)
// ---------------------------------------------------------------------------

enum Sex {
  male
  female
}

enum ActivityLevel {
  sedentary
  lightly_active
  moderately_active
  very_active
  extra_active
}

enum GoalType {
  weight_loss
  maintenance
  muscle_gain
  general_health
}

enum PreferredUnits {
  metric
  imperial
}

model UserProfile {
  id                 String         @id @default(cuid())
  userId             String         @unique
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName        String
  ageYears           Int
  sex                Sex
  heightCm           Float
  currentWeightG     Int
  targetWeightG      Int
  activityLevel      ActivityLevel
  dietaryPreferences String[]       @default([])
  goalType           GoalType
  preferredUnits     PreferredUnits @default(metric)
  country            String
  timezone           String
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@map("user_profile")
}

enum SafetyLevel {
  green
  yellow
  red
}

model Goal {
  id                   String      @id @default(cuid())
  userId               String      @unique
  user                 User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  bmrKcal              Int
  tdeeKcal             Int
  caloriesKcal         Int
  proteinG             Int
  carbsG               Int
  fatG                 Int
  fibreG               Int
  waterMl              Int
  steps                Int
  exerciseMinutes      Int
  weeklyWeightChangeG  Int
  /// Overridden target field names (e.g. ["caloriesKcal","proteinG"]).
  overriddenFields     String[]    @default([])
  /// Story 1.7 / FR-5 — recorded safety ladder decision.
  safetyLevel          SafetyLevel @default(green)
  safetyReasons        String[]    @default([])
  safetyConsentGiven   Boolean     @default(false)
  safetyConsentAt      DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  @@map("goal")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
