// FitMe AI — Prisma schema
// Story 1.1 establishes the Better Auth core models (AD-6). Domain models
// (UserProfile, Goal, FoodEntry, ...) are added by their own stories so each
// migration is scoped to the story that needs it (see epics.md).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Better Auth core (email/password, DB-backed sessions)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions Session[]
  accounts Account[]
  profile  UserProfile?
  goal     Goal?

  @@map("user")
}

// ---------------------------------------------------------------------------
// Profile & goals (Story 1.6 / FR-4) — canonical units: g, cm, kcal, ml (AD-11)
// ---------------------------------------------------------------------------

enum Sex {
  male
  female
}

enum ActivityLevel {
  sedentary
  lightly_active
  moderately_active
  very_active
  extra_active
}

enum GoalType {
  weight_loss
  maintenance
  muscle_gain
  general_health
}

enum PreferredUnits {
  metric
  imperial
}

model UserProfile {
  id                 String         @id @default(cuid())
  userId             String         @unique
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName        String
  ageYears           Int
  sex                Sex
  heightCm           Float
  currentWeightG     Int
  targetWeightG      Int
  activityLevel      ActivityLevel
  dietaryPreferences String[]       @default([])
  goalType           GoalType
  preferredUnits     PreferredUnits @default(metric)
  country            String
  timezone           String
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@map("user_profile")
}

enum SafetyLevel {
  green
  yellow
  red
}

model Goal {
  id                   String      @id @default(cuid())
  userId               String      @unique
  user                 User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  bmrKcal              Int
  tdeeKcal             Int
  caloriesKcal         Int
  proteinG             Int
  carbsG               Int
  fatG                 Int
  fibreG               Int
  waterMl              Int
  steps                Int
  exerciseMinutes      Int
  weeklyWeightChangeG  Int
  /// Overridden target field names (e.g. ["caloriesKcal","proteinG"]).
  overriddenFields     String[]    @default([])
  /// Story 1.7 / FR-5 — recorded safety ladder decision.
  safetyLevel          SafetyLevel @default(green)
  safetyReasons        String[]    @default([])
  safetyConsentGiven   Boolean     @default(false)
  safetyConsentAt      DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  @@map("goal")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// Nutrition catalog (Story 2.1 / FR-7 data layer) — AD-3, AD-11
// Ingredient macros are per 100 g. Missing macros are null (never fabricated).
// ---------------------------------------------------------------------------

enum FoodKind {
  simple
  composite
}

model Ingredient {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  aliases       String[] @default([])
  /// Provenance note (e.g. USDA FDC id + hand-curated note). Never log as health payload.
  sourceLabel   String
  /// Energy and macros per 100 g. Null = unknown (not zero).
  energyKcal    Float?
  proteinG      Float?
  carbsG        Float?
  fatG          Float?
  fibreG        Float?
  sugarG        Float?
  sodiumMg      Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  recipeRows RecipeIngredient[]

  @@index([name])
  @@map("ingredient")
}

model Food {
  id                   String   @id @default(cuid())
  slug                 String   @unique
  name                 String
  aliases              String[] @default([])
  kind                 FoodKind @default(simple)
  /// Grams produced by the default recipe (sum of recipe ingredient grams).
  /// DB CHECK: defaultServingG > 0 (migration 20260726020000).
  defaultServingG      Int
  sourceLabel          String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  servings         FoodServing[]
  recipeIngredients RecipeIngredient[]

  @@index([name])
  @@map("food")
}

model FoodServing {
  id        String   @id @default(cuid())
  foodId    String
  food      Food     @relation(fields: [foodId], references: [id], onDelete: Cascade)
  name      String
  /// DB CHECK: grams > 0 (migration 20260726020000).
  grams     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([foodId, name])
  @@index([foodId])
  @@map("food_serving")
}

model RecipeIngredient {
  id           String     @id @default(cuid())
  foodId       String
  food         Food       @relation(fields: [foodId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  /// Grams of this ingredient in the food's defaultServingG yield.
  /// DB CHECK: grams > 0 (migration 20260726020000).
  grams        Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([foodId, ingredientId])
  @@index([foodId])
  @@index([ingredientId])
  @@map("recipe_ingredient")
}
